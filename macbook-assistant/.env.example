GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Built-in name or absolute path to a compatible openWakeWord .onnx model.
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
# Empty selects the PortAudio default input. Use --list-devices to pick an index.
AUDIO_DEVICE_INDEX=
SPEECH_RMS=350

TTS_VOICE=ko-KR-SunHiNeural
TTS_VOLUME=85
# ALSA PCM name, without the "alsa/" prefix.
ALSA_PCM=spdif_shared
# auto tries amixer Master then MPD on failure. mpd controls the digital music level.
VOLUME_BACKEND=auto
ALSA_CONTROL_DEVICE=
MPD_HOST=localhost
MPD_PORT=6600
MPD_PASSWORD=

CITY_NAME=부산
CITY_LAT_LON=35.1796,129.0756
MEMO_PATH=/opt/macbook-assistant/memo.json
HEALTH_DISK_PATH=/
