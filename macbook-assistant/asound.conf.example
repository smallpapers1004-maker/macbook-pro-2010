# Merge into /etc/asound.conf. Replace the hw addresses using aplay -l / arecord -l.
pcm.spdif_mix {
    type dmix
    ipc_key 201016
    ipc_key_add_uid false
    # MPD and the assistant normally run as different Unix users.
    ipc_perm 0666
    slave {
        pcm "hw:0,1"
        format S16_LE
        rate 48000
        channels 2
    }
}
pcm.spdif_shared {
    type plug
    slave.pcm "spdif_mix"
    hint {
        show on
        description "Shared S/PDIF PCM"
    }
}
# Optional 3.5 mm headphone / RCA output.
pcm.analog_mix {
    type dmix
    ipc_key 201017
    ipc_key_add_uid false
    ipc_perm 0666
    slave {
        pcm "hw:0,0"
        format S16_LE
        rate 48000
        channels 2
    }
}
pcm.analog_shared {
    type plug
    slave.pcm "analog_mix"
    hint {
        show on
        description "Shared analog headphone PCM"
    }
}
pcm.assistant_mic {
    type plug
    slave.pcm "hw:0,0"
    hint {
        show on
        description "Assistant microphone (ALSA plug)"
    }
}
