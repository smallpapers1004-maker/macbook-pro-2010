# ip -br link 명령으로 실제 유선 인터페이스를 찾아 바꿉니다.
SLEEP_GUARD_INTERFACE=enp2s0
SLEEP_GUARD_IDLE_MINUTES=30
SLEEP_GUARD_TRAFFIC_BYTES_PER_SECOND=50000
# SSH/SMB 포트. CasaOS 관련 80,8080,4533,8384,22000은 항상 추가됩니다.
SLEEP_GUARD_TCP_PORTS=22,445
# off / block / allow-only
SLEEP_GUARD_HOURS_MODE=off
SLEEP_GUARD_ACTIVE_HOURS=19:00-23:00
